      border-radius: 7px;
      border: 1px solid var(--line);
      background: #1c2940;
      color: white;
      font-size: 11px;
      cursor: pointer;
    }

    .link-btn:hover {
      background: #342958;
    }

    [hidden] {
      display: none !important;
    }

