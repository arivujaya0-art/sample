  <script>
  "use strict";


  /* =====================================
     THEME PREFERENCE
     Light by default; remember user choice.
  ====================================== */
  const THEME_KEY = "sls_theme_preference";
  const themeToggle = document.getElementById("themeToggle");
  const themeLabel = document.getElementById("themeLabel");
  const themeMeta = document.querySelector('meta[name="theme-color"]');

  function applyTheme(theme) {
    const selected = theme === "dark" ? "dark" : "light";
    document.documentElement.dataset.theme = selected;
    if (themeLabel) themeLabel.textContent = selected === "dark" ? "Dark" : "Light";
    if (themeToggle) {
      themeToggle.setAttribute("aria-pressed", String(selected === "dark"));
      themeToggle.setAttribute(
        "aria-label",
        selected === "dark" ? "Switch to light mode" : "Switch to dark mode"
      );
    }
    if (themeMeta) themeMeta.content = selected === "dark" ? "#090e1c" : "#f4f6fb";
  }

  let savedTheme = "light";
  try {
    const storedTheme = localStorage.getItem(THEME_KEY);
    if (storedTheme === "dark" || storedTheme === "light") savedTheme = storedTheme;
  } catch (error) {
    console.warn("Theme preference storage unavailable.");
  }
  applyTheme(savedTheme);

  themeToggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    applyTheme(nextTheme);
    try {
      localStorage.setItem(THEME_KEY, nextTheme);
    } catch (error) {
      console.warn("Could not save theme preference.");
    }
  });


  /* YEAR */

  document.getElementById("year").textContent =
    new Date().getFullYear();


  /* =====================================
     VIDEO-AREA PLAY BUTTON + 6-MIN COOLDOWN
     - Overlay appears on every page load/refresh.
     - Clicking Play opens AD_REDIRECT_URL on a trusted click.
     - After click, overlay hides and returns in 6 minutes.
  ====================================== */

  const AD_REDIRECT_URL = "https://arwf.org/4/a20dc74bc92fb6072642a86814bf8e78";
  const VIDEO_PLAY_INTERVAL = 6 * 60 * 1000;

  const videoAdTapLayer = document.getElementById("videoAdTapLayer");
  const videoAdPlayButton = document.getElementById("videoAdPlayButton");
  const videoAdPlayLabel = document.getElementById("videoAdPlayLabel");

  let videoPlayTimer = null;
  let videoPlayButtonBusy = false;

  function setVideoPlayLabel(value) {
    if (videoAdPlayLabel) videoAdPlayLabel.textContent = value;
  }

  function openAdDestination() {
    if (!AD_REDIRECT_URL) return;
    try {
      window.open(AD_REDIRECT_URL, "_blank", "noopener,noreferrer");
    } catch (error) {
      console.warn("Popup blocked or failed:", error);
    }
  }

  function showVideoPlayOverlay() {
    if (!videoAdTapLayer) return;
    videoAdTapLayer.hidden = false;
    videoAdTapLayer.style.display = "flex";
    videoPlayButtonBusy = false;
    setVideoPlayLabel("Play video");
  }

  function hideVideoPlayOverlayForCooldown() {
    if (!videoAdTapLayer) return;
    videoAdTapLayer.hidden = true;
    videoAdTapLayer.style.display = "none";

    if (videoPlayTimer) clearTimeout(videoPlayTimer);
    videoPlayTimer = setTimeout(() => {
      showVideoPlayOverlay();
    }, VIDEO_PLAY_INTERVAL);
  }

  if (videoAdTapLayer && videoAdPlayButton) {
    videoAdPlayButton.addEventListener("click", () => {
      if (videoPlayButtonBusy) return;
      videoPlayButtonBusy = true;

      openAdDestination();
      hideVideoPlayOverlayForCooldown();
    });

    showVideoPlayOverlay();
  }


  /* =====================================
     EMOJI REACTIONS
  ====================================== */

  const emojiRain = document.getElementById("emojiRain");

  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  let lastReactionTime = 0;

  const REACTION_COOLDOWN = 700;
  const MAX_EMOJIS = 40;

  function createEmojiRain(emoji) {

    if (reducedMotion) return;

    while (emojiRain.childElementCount + 16 > MAX_EMOJIS) {
      emojiRain.firstElementChild?.remove();
    }

    for (let i = 0; i < 16; i++) {

      const item = document.createElement("span");

      item.className = "falling-emoji";
      item.textContent = emoji;

      item.style.left =
        (Math.random() * 100) + "vw";

      item.style.fontSize =
        (21 + Math.random() * 17) + "px";

      item.style.setProperty(
        "--duration",
        (1.8 + Math.random() * 1.5) + "s"
      );

      item.style.setProperty(
        "--drift",
        (Math.random() * 100 - 50) + "px"
      );

      item.style.setProperty(
        "--spin",
        (Math.random() * 600 - 300) + "deg"
      );

      item.style.animationDelay =
        (Math.random() * .25) + "s";

      emojiRain.appendChild(item);

      item.addEventListener(
        "animationend",
        () => item.remove(),
        { once: true }
      );

    }
  }

  document.querySelectorAll("[data-emoji]").forEach(button => {

    button.addEventListener("click", () => {

      const now = Date.now();

      if (now - lastReactionTime < REACTION_COOLDOWN) {
        return;
      }

      lastReactionTime = now;

      createEmojiRain(button.dataset.emoji);

    });

  });

  </script>


  <!-- =====================================
       FIREBASE LIVE CHAT SYSTEM
  ====================================== -->

  <script type="module">

  import { initializeApp }
    from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";

  import {
    getAuth,
    signInAnonymously,
    onAuthStateChanged
  } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

  import {
    getDatabase,
    ref,
    set,
    push,
    onValue,
    onDisconnect,
    serverTimestamp,
    query,
    limitToLast
  } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";


  /* =====================================
     FIREBASE CONFIGURATION
  ====================================== */

  const firebaseConfig = {

    apiKey: "AIzaSyBsjLULjIhjxraftPtrqeIdYh9miFWfl5o",

    authDomain: "fanpulse-tamil.firebaseapp.com",

    databaseURL:
      "https://fanpulse-tamil-default-rtdb.firebaseio.com",

    projectId: "fanpulse-tamil",

    storageBucket:
      "fanpulse-tamil.firebasestorage.app",

    messagingSenderId: "87663314132",

    appId:
      "1:87663314132:web:303083547fe6c22ec62741",

    measurementId: "G-RC9H0J1WNQ"

  };


  /* =====================================
     SETTINGS
  ====================================== */

  const MAX_MESSAGES = 30;

  const MAX_NAME_LENGTH = 24;

  const MAX_MESSAGE_LENGTH = 300;

  const SEND_COOLDOWN = 1200;

  const NAME_KEY = "sls_live_chat_name_v1";


  /* =====================================
     INITIALIZATION
  ====================================== */

  const app = initializeApp(firebaseConfig);

  const auth = getAuth(app);

  const db = getDatabase(app);


  /* HTML ELEMENTS */

  const $ = id => document.getElementById(id);

  const viewerCountEl = $("viewerCount");

  const activeNameLabelEl = $("activeNameLabel");

  const editNameBtn = $("editNameBtn");

  const nameSetupEl = $("nameSetup");

  const nameInputEl = $("nameInput");

  const saveNameBtn = $("saveNameBtn");

  const messagesEl = $("chatMessages");

  const chatInputEl = $("chatInput");

  const chatFormEl = $("chatForm");

  const sendBtn = $("sendBtn");

  const chatStatusEl = $("chatStatus");


  /* =====================================
     APPLICATION STATE
  ====================================== */

  let currentUser = null;

  let displayName = "";

  let presenceConnected = false;

  let presenceStarted = false;

  let listenersStarted = false;

  let authFailed = false;

  let lastSendTime = 0;

  let shouldAutoScroll = true;

  let chatMessages = [];

  let presenceByUID = {};

  let onlineUIDs = new Set();


  /* =====================================
     SAVED DISPLAY NAME
  ====================================== */

  try {

    displayName = (
      localStorage.getItem(NAME_KEY) || ""
    ).trim().slice(0, MAX_NAME_LENGTH);

  } catch (error) {

    displayName = "";

  }

  nameInputEl.value = displayName;


  /* =====================================
     SAFE ELEMENT CREATION
  ====================================== */

  function makeElement(tag, className, text) {

    const element = document.createElement(tag);

    if (className) {
      element.className = className;
    }

    if (text !== undefined) {
      element.textContent = text;
    }

    return element;
  }


  /* =====================================
     LAST SEEN FORMAT
  ====================================== */

  function formatLastSeen(timestamp) {

    if (
      typeof timestamp !== "number" ||
      !Number.isFinite(timestamp) ||
      timestamp <= 0
    ) {
      return "Last seen unavailable";
    }

    const seconds = Math.max(
      0,
      Math.floor((Date.now() - timestamp) / 1000)
    );

    if (seconds < 60) {
      return "Last seen just now";
    }

    const minutes = Math.floor(seconds / 60);

    if (minutes < 60) {

      return `Last seen ${minutes} min${minutes === 1 ? "" : "s"} ago`;

    }

    const hours = Math.floor(minutes / 60);

    if (hours < 24) {

      return `Last seen ${hours} hour${hours === 1 ? "" : "s"} ago`;

    }

    const days = Math.floor(hours / 24);

    return `Last seen ${days} day${days === 1 ? "" : "s"} ago`;

  }


  /* =====================================
     CHAT INTERFACE
  ====================================== */

  function refreshChatState() {

    const canChat = Boolean(
      currentUser && displayName && !authFailed
    );

    nameSetupEl.hidden = Boolean(displayName);

    activeNameLabelEl.textContent = displayName
      ? `Chatting as ${displayName}`
      : "";

    editNameBtn.hidden = !displayName;

    chatInputEl.disabled = !canChat;

    sendBtn.disabled = !canChat;

    chatInputEl.placeholder = canChat
      ? "Type a message..."
      : "Choose a name to send messages...";

    if (authFailed) {

      chatStatusEl.textContent =
        "Authentication failed. Please refresh.";

    } else if (!currentUser) {

      chatStatusEl.textContent =
        "Connecting to live chat...";

    } else if (displayName) {

      chatStatusEl.textContent =
        "You are ready to participate in the live chat.";

    } else {

      chatStatusEl.textContent =
        "You can read messages. Choose a name to participate.";

    }

  }


  /* =====================================
     SAVE OR CHANGE NAME
  ====================================== */

  async function saveDisplayName() {

    const cleaned = nameInputEl.value.trim();

    if (!cleaned) {

      nameInputEl.focus();

      chatStatusEl.textContent =
        "Please enter a display name.";

      return;
    }

    if (cleaned.length > MAX_NAME_LENGTH) return;

    displayName = cleaned;

    try {

      localStorage.setItem(NAME_KEY, displayName);

    } catch (error) {

      console.warn("Name storage unavailable.");

    }

    refreshChatState();

    await updatePresence();

    if (!chatInputEl.disabled) {
      chatInputEl.focus();
    }

  }


  saveNameBtn.addEventListener(
    "click",
    saveDisplayName
  );

  nameInputEl.addEventListener("keydown", event => {

    if (event.key === "Enter") {

      event.preventDefault();

      saveDisplayName();

    }

  });

  editNameBtn.addEventListener("click", () => {

    nameInputEl.value = displayName;

    nameSetupEl.hidden = false;

    nameInputEl.focus();

  });


  /* =====================================
     PRESENCE SYSTEM
     ALL VISITORS ARE COUNTED
     NAME IS NOT REQUIRED
  ====================================== */

  async function updatePresence() {

    if (!currentUser || !presenceConnected) return;

    const userRef = ref(
      db,
      `presence/${currentUser.uid}`
    );

    try {

      await onDisconnect(userRef).set({

        name: displayName || "Viewer",

        online: false,

        lastOnline: serverTimestamp()

      });

      await set(userRef, {

        name: displayName || "Viewer",

        online: true,

        lastOnline: serverTimestamp()

      });

    } catch (error) {

      console.error(
        "Presence update failed:",
        error
      );

      chatStatusEl.textContent =
        "Unable to update online status.";

    }

  }


  /* =====================================
     SINGLE CONNECTION LISTENER
  ====================================== */

  function startPresenceTracking() {

    if (!currentUser || presenceStarted) return;

    presenceStarted = true;

    const connectionRef = ref(
      db,
      ".info/connected"
    );

    onValue(

      connectionRef,

      async snapshot => {

        presenceConnected = snapshot.val() === true;

        if (!presenceConnected) return;

        await updatePresence();

      },

      error => {

        console.error(
          "Presence connection error:",
          error
        );

      }

    );

  }


  /* =====================================
     VIEWER COUNT + PRESENCE DATA
  ====================================== */

  function startViewerTracking() {

    onValue(

      ref(db, "presence"),

      snapshot => {

        presenceByUID = snapshot.val() || {};

        const onlineUsers = Object.entries(
          presenceByUID
        ).filter(([uid, user]) => {

          return user && user.online === true;

        });

        onlineUIDs = new Set(
          onlineUsers.map(([uid]) => uid)
        );

        viewerCountEl.replaceChildren();
        const eyeIcon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        eyeIcon.setAttribute("viewBox", "0 0 24 24");
        eyeIcon.setAttribute("class", "viewer-icon");
        eyeIcon.setAttribute("aria-hidden", "true");
        const eyePath = document.createElementNS("http://www.w3.org/2000/svg", "path");
        eyePath.setAttribute("d", "M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z");
        const eyePupil = document.createElementNS("http://www.w3.org/2000/svg", "circle");
        eyePupil.setAttribute("cx", "12");
        eyePupil.setAttribute("cy", "12");
        eyePupil.setAttribute("r", "3");
        eyeIcon.append(eyePath, eyePupil);
        const viewerText = document.createElement("span");
        const DISPLAY_VIEWER_OFFSET = 1000;
        viewerText.textContent = `${onlineUIDs.size + DISPLAY_VIEWER_OFFSET} Watching`;
        viewerCountEl.replaceChildren(eyeIcon, viewerText);

        renderMessages();

      },

      error => {

        console.error(
          "Viewer count error:",
          error
        );

        viewerCountEl.textContent = "Viewer count unavailable";

      }

    );

  }


  /* =====================================
     RENDER CHAT MESSAGES
  ====================================== */

  function renderMessages() {

    const wasNearBottom = shouldAutoScroll;

    messagesEl.replaceChildren();

    if (chatMessages.length === 0) {

      messagesEl.appendChild(

        makeElement(
          "div",
          "chat-msg",
          "No messages yet. Be the first to say hello!"
        )

      );

      return;

    }

    chatMessages.forEach(message => {

      const row = makeElement(
        "div",
        "chat-msg"
      );

      const authorRow = makeElement(
        "span",
        "chat-author-row"
      );

      const author = makeElement(
        "span",
        "chat-author",
        `${String(message.name || "Viewer").slice(0, MAX_NAME_LENGTH)}:`
      );

      authorRow.appendChild(author);

      if (message.uid) {

        const user = presenceByUID[message.uid];

        if (user && user.online === true) {

          const badge = makeElement(
            "span",
            "chat-online",
            "Online"
          );

          authorRow.appendChild(badge);

        } else if (user) {

          const lastSeen = makeElement(
            "span",
            "chat-last-seen",
            formatLastSeen(user.lastOnline)
          );

          authorRow.appendChild(lastSeen);

        } else {

          const unavailable = makeElement(
            "span",
            "chat-last-seen",
            "Last seen unavailable"
          );

          authorRow.appendChild(unavailable);

        }

      }

      const content = makeElement(
        "span",
        "",
        String(message.text || "").slice(
          0,
          MAX_MESSAGE_LENGTH
        )
      );

      row.append(authorRow, content);

      messagesEl.appendChild(row);

    });

    if (wasNearBottom) {

      messagesEl.scrollTop =
        messagesEl.scrollHeight;

    }

  }


  /* =====================================
     CHAT MESSAGE LISTENER
     EVERY AUTHENTICATED VISITOR CAN READ
  ====================================== */

  function startMessageListener() {

    const messagesQuery = query(

      ref(db, "messages"),

      limitToLast(MAX_MESSAGES)

    );

    onValue(

      messagesQuery,

      snapshot => {

        chatMessages = [];

        snapshot.forEach(child => {

          chatMessages.push(child.val());

        });

        renderMessages();

      },

      error => {

        console.error(
          "Message loading error:",
          error
        );

        messagesEl.replaceChildren();

        messagesEl.appendChild(

          makeElement(
            "div",
            "chat-msg",
            "Unable to load messages. Check Firebase database permissions."
          )

        );

        chatStatusEl.textContent =
          "Chat loading failed. Please check your connection.";

      }

    );

  }


  /* =====================================
     CHAT SCROLL MANAGEMENT
  ====================================== */

  messagesEl.addEventListener("scroll", () => {

    const distance =
      messagesEl.scrollHeight -
      messagesEl.scrollTop -
      messagesEl.clientHeight;

    shouldAutoScroll = distance < 48;

  });


  /* =====================================
     SEND MESSAGE (NO AD TRIGGER ON SEND)
     DISPLAY NAME REQUIRED
  ====================================== */

  chatFormEl.addEventListener(
    "submit",
    async event => {

      event.preventDefault();

      if (!currentUser || !displayName || authFailed) {

        refreshChatState();

        return;

      }

      const messageText = chatInputEl.value
        .trim()
        .slice(0, MAX_MESSAGE_LENGTH);

      if (!messageText) return;

      const now = Date.now();

      if (now - lastSendTime < SEND_COOLDOWN) {
        return;
      }

      lastSendTime = now;

      sendBtn.disabled = true;

      chatInputEl.disabled = true;

      try {

        await push(

          ref(db, "messages"),

          {

            uid: currentUser.uid,

            name: displayName,

            text: messageText,

            createdAt: serverTimestamp()

          }

        );

        chatInputEl.value = "";

        shouldAutoScroll = true;

        chatStatusEl.textContent =
          "Message sent successfully.";

      } catch (error) {

        console.error(
          "Message sending failed:",
          error
        );

        chatStatusEl.textContent =
          `Message failed: ${error.code || "Please try again."}`;

      } finally {

        const canChat = Boolean(
          currentUser && displayName && !authFailed
        );

        chatInputEl.disabled = !canChat;

        sendBtn.disabled = !canChat;

        if (canChat) {
          chatInputEl.focus();
        }

      }

    }
  );


  /* =====================================
     LAST-SEEN REFRESH
     Updates displayed relative time every minute
  ====================================== */

  setInterval(() => {

    renderMessages();

  }, 60 * 1000);


  /* =====================================
     AUTHENTICATION
  ====================================== */

  onAuthStateChanged(

    auth,

    user => {

      currentUser = user;

      if (!user) return;

      authFailed = false;

      refreshChatState();

      startPresenceTracking();

      if (!listenersStarted) {

        listenersStarted = true;

        startViewerTracking();

        startMessageListener();

      }

    },

    error => {

      console.error(
        "Authentication state error:",
        error
      );

    }

  );


  /* =====================================
     ANONYMOUS LOGIN
  ====================================== */

  signInAnonymously(auth).catch(error => {

    authFailed = true;

    console.error(
      "Anonymous authentication failed:",
      error
    );

    viewerCountEl.textContent = "Connection unavailable";

    chatStatusEl.textContent =
      "Unable to connect. Please refresh the page.";

    refreshChatState();

  });

  </script>

</body>
</html>
