      --red: #dc3545;
      --radius: 18px;
      --surface-shadow: 0 12px 34px rgba(28, 39, 68, .08);
    }

    html[data-theme="dark"] {
      color-scheme: dark;
      --bg: #090e1c;
      --bg2: #0e1629;
      --panel: #141e33;
      --panel2: #10192b;
      --gold: #ffd166;
      --purple: #9b5cff;
      --purple2: #6d4aff;
      --text: #f5f7ff;
      --muted: #9daac3;
      --line: rgba(255,255,255,.09);
      --green: #4ade80;
      --red: #fb7185;
      --surface-shadow: 0 10px 35px rgba(0,0,0,.18);
    }

    * {
      box-sizing: border-box;
    }

    html {
      min-height: 100%;
      scroll-behavior: smooth;
      background: var(--bg);
    }

    body {
      margin: 0;
      min-height: 100vh;
      color: var(--text);
      background:
        radial-gradient(ellipse at 0% 0%, rgba(112, 65, 255, .18), transparent 36%),
