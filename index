    .name-setup {
      padding: 13px 15px;
      background: rgba(139,92,246,.09);
      border-bottom: 1px solid var(--line);
    }

    .name-instruction {
      margin-bottom: 9px;
      color: #d9c7ff;
      font-size: 12px;
      font-weight: 650;
    }

    .name-setup-row {
      display: flex;
      gap: 9px;
    }

    .chat-input,
