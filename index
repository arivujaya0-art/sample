        linear-gradient(180deg, #090e1c, #0b1222);
      font-family:
        system-ui,
        -apple-system,
        "Segoe UI",
        Roboto,
        Arial,
        sans-serif;
      line-height: 1.55;
    }

    button, input {
      font: inherit;
    }

    button:focus-visible,
    input:focus-visible {
      outline: 2px solid var(--gold);
      outline-offset: 3px;
    }

    .container {
      width: min(100% - 28px, 1050px);
      margin: auto;
    }

    /* TOP BRAND BAR */

    .topbar {
      padding: 9px 15px;
      text-align: center;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.5px;
      color: white;
      background: linear-gradient(100deg, #6d35d9, #a13fca, #d12d79);
    }

    /* HEADER */

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      padding: 19px 0;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .logo {
      display: grid;
      place-items: center;
      width: 47px;
      height: 47px;
      flex-shrink: 0;
      border-radius: 13px;
      color: white;
      font-size: 16px;
      font-weight: 950;
      background: linear-gradient(135deg, #a855f7, #5b4be8);
      box-shadow: 0 5px 22px rgba(124,58,237,.3);
    }

    .brand-name {
      font-size: 17px;
      font-weight: 900;
      line-height: 1.25;
    }

    .brand-sub {
      color: var(--muted);
      font-size: 11px;
      margin-top: 3px;
    }

    .live-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 11px;
      border: 1px solid rgba(248,113,113,.2);
      border-radius: 7px;
      color: #fff;
      background: rgba(127,29,29,.55);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .5px;
      flex-shrink: 0;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: #fb7185;
      box-shadow: 0 0 10px #fb7185;
      animation: livePulse 1.5s infinite;
    }

    @keyframes livePulse {
      50% { opacity: .4; }
    }

    /* INTRO */

    .intro {
      text-align: center;
      padding: 31px 0 17px;
    }

    .eyebrow {
      color: var(--gold);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 2px;
    }

    h1 {
      margin: 8px 0;
      font-size: clamp(27px, 5vw, 39px);
      line-height: 1.2;
      font-weight: 900;
      background: linear-gradient(100deg, #fff, #e4d5ff, #ffd166);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .intro p {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
    }

    /* SECTION CARDS */

    .card {
      margin: 15px 0 19px;
      padding: clamp(11px, 2vw, 18px);
      background: linear-gradient(145deg, rgba(25,37,61,.96), rgba(17,27,46,.98));
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 10px 35px rgba(0,0,0,.16);
    }

    .section-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 13px;
    }

    .section-heading h2 {
      margin: 0;
      font-size: clamp(16px, 2vw, 19px);
      font-weight: 850;
    }

