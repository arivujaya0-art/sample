  <style>
    :root {
      color-scheme: light;
      --bg: #f4f6fb;
      --bg2: #ffffff;
      --panel: #ffffff;
      --panel2: #f8faff;
      --gold: #a16207;
      --purple: #7048e8;
      --purple2: #5b3cc4;
