    .player {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      border-radius: 11px;
      background: #000;
      border: 1px solid rgba(255,255,255,.07);
    }

    /* Video-area Play overlay: returns every six minutes and on each page load */
    .video-ad-tap-layer {
      position: absolute;
      inset: 0;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 0, 0, .28);
    }

    .video-ad-play-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      min-width: 170px;
      padding: 15px 24px;
      border: 0;
      border-radius: 999px;
      color: #fff;
      background: #e11d48;
      box-shadow: 0 8px 28px rgba(0,0,0,.35);
      font: inherit;
      font-size: 17px;
      font-weight: 800;
      cursor: pointer;
    }

    .video-ad-play-button:hover { filter: brightness(1.08); }
    .video-ad-play-button:focus-visible {
      outline: 3px solid #fff;
      outline-offset: 4px;
    }
    .video-ad-play-icon { font-size: 20px; }

    .player iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    /* REACTIONS */

    .reactions {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
      padding: 13px 9px;
      border-radius: 11px;
      background: rgba(7,13,25,.55);
      border: 1px solid var(--line);
    }

    .reaction-btn {
      display: grid;
      place-items: center;
      min-width: 46px;
      min-height: 45px;
      padding: 5px 11px;
      border: 1px solid var(--line);
      border-radius: 25px;
      background: #1b2941;
      color: white;
      font-size: 22px;
      cursor: pointer;
      transition: transform .16s ease, background .16s ease;
    }

    .reaction-btn:hover {
      background: #392b62;
      transform: translateY(-2px);
    }

    .reaction-btn:active {
      transform: scale(1.12);
    }

    .reaction-hint {
      width: 100%;
      text-align: center;
      color: var(--muted);
      font-size: 10px;
    }

