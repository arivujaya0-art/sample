      width: 100%;
      min-width: 0;
      flex: 1;
      padding: 11px 13px;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 9px;
      color: white;
      background: #0a1222;
      font-size: 13px;
    }

    .chat-input::placeholder,
    .name-input::placeholder {
      color: #77849d;
    }

    .chat-btn {
      padding: 10px 17px;
      border: 0;
      border-radius: 9px;
      background: linear-gradient(135deg, #9b5cff, #6356ed);
      color: white;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      flex-shrink: 0;
      transition: filter .15s ease;
    }

    .chat-btn:hover {
      filter: brightness(1.14);
    }

    .chat-btn:disabled {
      opacity: .45;
      cursor: not-allowed;
    }

    /* MESSAGE AREA */

    .chat-messages {
      height: 320px;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 15px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      overflow-wrap: anywhere;
      scrollbar-width: thin;
      scrollbar-color: #465474 transparent;
    }

    .chat-msg {
      font-size: 13px;
      line-height: 1.55;
      overflow-wrap: anywhere;
    }

    .chat-author-row {
      display: inline-flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
      margin-right: 6px;
    }

    .chat-author {
      color: var(--gold);
      font-weight: 800;
    }

    .chat-online {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--green);
      font-size: 10px;
      font-weight: 750;
    }

    .chat-online::before {
      content: "";
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 7px rgba(74,222,128,.5);
    }

    .chat-last-seen {
      color: #94a3b8;
      font-size: 10px;
      font-weight: 550;
    }

    .chat-form {
      display: flex;
      gap: 9px;
      padding: 12px 15px;
      background: rgba(7,13,25,.7);
      border-top: 1px solid var(--line);
    }

    .chat-input:disabled {
      opacity: .65;
      cursor: not-allowed;
    }

    .chat-status {
      padding: 7px 15px;
      color: var(--muted);
      background: rgba(7,13,25,.4);
      font-size: 10px;
    }

