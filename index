    .footer {
      margin-top: 25px;
      padding: 19px 0 27px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      text-align: center;
      font-size: 11px;
    }

    .footer p {
      margin: 4px 0;
    }

    /* EMOJI ANIMATION */

    .emoji-rain {
      position: fixed;
      inset: 0;
      z-index: 99;
      overflow: hidden;
      pointer-events: none;
      contain: layout paint;
    }

    .falling-emoji {
      position: absolute;
      top: -50px;
      line-height: 1;
      will-change: transform, opacity;
      animation: fall var(--duration, 2.4s) linear forwards;
      filter: drop-shadow(0 3px 5px rgba(0,0,0,.3));
    }

    @keyframes fall {
      0% {
        transform: translate3d(0,-20px,0) rotate(0);
        opacity: 0;
      }

      10%, 85% {
        opacity: 1;
      }

      100% {
        transform:
          translate3d(var(--drift,25px),110vh,0)
          rotate(var(--spin,240deg));
        opacity: 0;
      }
    }

