    .chat-card {
      margin-top: 20px;
      overflow: hidden;
      background: linear-gradient(145deg, #17233a, #111b2e);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      box-shadow: 0 10px 35px rgba(0,0,0,.16);
